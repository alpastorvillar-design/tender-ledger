# Generate .env with: python scripts/create_local_env.py
# This example is documentation; do not use its placeholders as credentials.
# The helper adds only the settings a file does not have yet, so running it
# again after an upgrade never rewrites a secret already in use.

# The pipeline database (compose.yaml)
POSTGRES_PASSWORD=replace-with-a-generated-local-password
POSTGRES_PORT=5433

# Local Airflow (compose.airflow.yaml). Its metadata database, its UI login,
# and the two secrets Airflow itself signs and encrypts with.
AIRFLOW_METADATA_PASSWORD=replace-with-a-generated-local-password
AIRFLOW_ADMIN_PASSWORD=replace-with-a-generated-local-password
AIRFLOW__API_AUTH__JWT_SECRET=replace-with-a-generated-local-secret
AIRFLOW__CORE__FERNET_KEY=replace-with-a-generated-urlsafe-base64-32-byte-key

# Optional: which database an orchestrated run works on. Defaults to
# tender_ledger; set it to the database that holds the packages a manifest
# names. Not a secret, and not created by the helper.
TL_ORCHESTRATION_DB=tender_ledger
